# Copy this file to .env.local for local development.
# On Vercel, add the same names under Project → Settings → Environment Variables.
# Leave a value empty and that feature falls back to demo mode.

# --- Supabase (accounts + saved portfolios) ---
# Supabase dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key: server only. Used by the daily job to save shared stock summaries.
SUPABASE_SECRET_KEY=

# --- Market data ---
# finnhub.io → Dashboard → API key (free plan is enough to start)
FINNHUB_API_KEY=

# --- AI summaries (optional) ---
# console.anthropic.com → API Keys. Without it, OnWatch writes template summaries.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Reddit sentiment (optional) ---
# reddit.com/prefs/apps → create a "script" app
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Daily job protection ---
# Any long random string. Vercel sends it automatically to cron jobs.
CRON_SECRET=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to "true" only after you configure Sign in with Apple in Supabase.
NEXT_PUBLIC_ENABLE_APPLE=false
